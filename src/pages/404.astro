---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES, BRAND } from '../lib/sites';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  site={site}
  title="Page Not Found | Charcoal Hub"
  description="The page you requested could not be found on Charcoal Hub."
  canonical={canonical}
  noindex
>
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="lede">
        This page does not exist on {BRAND}. Browse the buying catalogue,
        request a quote, or continue to the specification data and
        knowledge sub-sites.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/contact/">Request a Quote</a>
        <a class="btn btn-secondary" href="/products/">View Products</a>
        <a class="btn btn-secondary" href="/">Back to Home</a>
        <a class="btn btn-ghost" href={`${SITES.data}/`} target="_blank" rel="noopener">Specification data</a>
        <a class="btn btn-ghost" href={`${SITES.knowledge}/`} target="_blank" rel="noopener">Knowledge hub</a>
      </div>
    </div>
  </div>
</BaseLayout>
