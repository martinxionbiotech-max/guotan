---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = `${SITES.main}/contact/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Contact', url: canonical },
  ]),
];
---

<BaseLayout
  site={site}
  title="Contact"
  description="Contact Charcoal Hub for sourcing, samples, OEM and private label charcoal."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <div class="page-title container">
    <h1>Contact</h1>
    <p class="lede">For quotes, samples and private-label projects.</p>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div class="card">
          <h3>Email</h3>
          <p><a href="mailto:sales@guotan.com">sales@guotan.com</a></p>
        </div>
        <div class="card">
          <h3>Fastest path</h3>
          <p>Use the structured forms so we can route your request precisely.</p>
          <p><a class="card-link" href="/request-quote/">Request a Quote →</a></p>
          <p><a class="card-link" href="/request-sample/">Request Samples →</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
