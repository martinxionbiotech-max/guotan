---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = `${SITES.main}/contact/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Contact', url: canonical },
  ]),
];
const WHATSAPP = 'https://wa.me/8615153588090';
---

<BaseLayout
  site={site}
  title="Contact"
  description="Contact Charcoal Hub sales for quotes, samples, OEM and private label charcoal."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <div class="page-title container">
    <h1>Contact</h1>
    <p class="lede">For quotes, samples and private-label projects.</p>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div class="card">
          <h3>Sales Director</h3>
          <p><strong>Joanna D.</strong></p>
          <p>
            Phone / WhatsApp:<br />
            <a href="tel:+8615153588090">+86 15153588090</a>
          </p>
          <p>
            Email:<br />
            <a href="mailto:joanna@dinweys.com">joanna@dinweys.com</a>
          </p>
          <p style="margin-top:1.25rem;">
            <a
              class="btn btn-primary"
              href={WHATSAPP}
              target="_blank"
              rel="noopener"
            >Chat on WhatsApp Now</a
            >
          </p>
        </div>
        <div class="card">
          <h3>Fastest path</h3>
          <p>Use the structured forms so we can route your request precisely.</p>
          <p><a class="card-link" href="/request-sample/">Request Samples →</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
