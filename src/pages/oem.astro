---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = `${SITES.main}/oem/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'OEM', url: canonical },
  ]),
];
---

<BaseLayout
  site={site}
  title="OEM Charcoal Manufacturing"
  description="OEM charcoal manufacturing — custom product, size and packaging built to your specification with sampling and inspection."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'OEM', url: '/oem/' }]}
>
  <div class="page-title container">
    <h1>OEM Charcoal Manufacturing</h1>
    <p class="lede">
      Manufacture charcoal to your specification — custom raw material, size, shape and packaging —
      with a structured sampling and inspection workflow before bulk production.
    </p>
  </div>

  <section class="section">
    <div class="container">
      <h2>How OEM Works</h2>
      <div class="prose">
        <p>
          OEM (original equipment manufacturing) means the product is manufactured to your
          specification and, where requested, under your brand. The workflow follows a
          sample-first discipline: you approve a pre-production sample before any bulk run begins.
        </p>
        <ol>
          <li><strong>Choose Product</strong> — coconut shell hookah, BBQ or bamboo charcoal.</li>
          <li><strong>Choose Size</strong> — 25 mm / 26 mm / 27 mm cube, flat, or a custom dimension.</li>
          <li><strong>Choose Packaging</strong> — bulk, retail box, or custom printed.</li>
          <li><strong>Submit Logo</strong> — your artwork and brand requirements.</li>
          <li><strong>Sample</strong> — approve a pre-production sample before production.</li>
          <li><strong>Production</strong> — manufacture to the agreed specification.</li>
          <li><strong>Inspection</strong> — quality control against the agreed spec before shipment.</li>
          <li><strong>Shipment</strong> — export and delivery to your destination port.</li>
        </ol>
        <p>
          The same eight steps drive our <a href="/private-label/">private label</a> service; OEM
          is the broader term, covering custom specification even when you do not put a brand on the
          box.
        </p>
      </div>

      <h2>What OEM Changes About the Order</h2>
      <div class="prose">
        <p>
          Two things change when an order moves from stock product to OEM: the minimum order
          quantity and the lead time. Both are driven by the same economics — a custom run needs
          production setup and, where printed packaging is involved, a print run.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Order type</th><th>Typical MOQ</th><th>Why</th></tr>
          </thead>
          <tbody>
            <tr><td>Stock packaging</td><td class="spec-value">~1 tonne</td><td>No setup or print run; product is already made</td></tr>
            <tr><td>OEM, printed boxes</td><td class="spec-value">One 20 ft container</td><td>Custom run + printed packaging minimum</td></tr>
          </tbody>
        </table>
      </div>
      <p class="updated">
        MOQ figures reflect common industry practice and public supplier listings; the binding
        figure is always the one in your written quotation.
      </p>

      <h2>Printing &amp; Customization Options</h2>
      <div class="prose">
        <ul>
          <li><strong>Box printing</strong> — full colour logo, multilingual panels, barcode and batch coding on the retail box and outer carton.</li>
          <li><strong>Size runs</strong> — cube sizes 22 / 25 / 26 / 27 mm typically run on the same production line.</li>
          <li><strong>Specification targets</strong> — ash, moisture, fixed carbon and size tolerance written into the purchase order against a stated method.</li>
        </ul>
        <p>
          A spec target without a stated test method is not enforceable. Our specification pages
          on the <a href={`${SITES.data}/specifications/`} target="_blank" rel="noopener">data sub-site</a>
          explain the six core metrics (ash, moisture, fixed carbon, volatile matter, burning time,
          size tolerance) so you can write a contract that can actually be checked.
        </p>
      </div>

      <div class="cta-banner">
        <h2>Have a custom specification?</h2>
        <p>Tell us what you need — we'll respond with feasibility and a quote.</p>
        <a class="btn btn-primary" href="/contact/">Start an OEM Project →</a>
      </div>
    </div>
  </section>
</BaseLayout>
