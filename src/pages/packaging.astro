---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = `${SITES.main}/packaging/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Packaging', url: canonical },
  ]),
];
---

<BaseLayout
  site={site}
  title="Charcoal Packaging Options"
  description="Charcoal packaging options for export — bulk bags, retail boxes and private-label packaging, matched to logistics and destination market."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Packaging', url: '/packaging/' }]}
>
  <div class="page-title container">
    <h1>Packaging</h1>
    <p class="lede">
      Packaging affects logistics cost, shelf life and brand presentation. We match packaging format
      to your market and shipping plan.
    </p>
    <div class="page-title-media">
      <img src="/images/page-packaging.webp" alt="Kraft retail boxes and bulk sacks stacked on pallets in a charcoal packaging workspace — conceptual illustration" width="1600" height="900" loading="lazy" />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <h3>Bulk</h3>
          <p>Large bags for distributors and repackers — lowest packaging cost per unit.</p>
        </div>
        <div class="card">
          <h3>Retail Box</h3>
          <p>Consumer-ready boxes for retail shelves and e-commerce.</p>
        </div>
        <div class="card">
          <h3>Private Label</h3>
          <p>Your brand on the box and outer carton, built to your artwork.</p>
        </div>
      </div>

      <h2>Standard Retail Formats</h2>
      <div class="prose">
        <p>
          Hookah-grade coconut shell charcoal is commonly packed in a graduated set of retail
          weights. The figures below reflect public supplier listings and are provided as a
          planning reference, not a guarantee for any order.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Format</th><th>Typical content</th><th>Role</th></tr>
          </thead>
          <tbody>
            <tr><td>1 kg box</td><td class="spec-value">~72 × 25 mm cubes</td><td>Standard retail unit</td></tr>
            <tr><td>1.2 kg pack</td><td class="spec-value">Scaled retail pack</td><td>Alternate retail size</td></tr>
            <tr><td>2 kg pack</td><td class="spec-value">Larger retail pack</td><td>Home / bulk retail</td></tr>
            <tr><td>10 kg pack</td><td class="spec-value">Bulk retail</td><td>Distributors, lounges</td></tr>
            <tr><td>Master carton</td><td class="spec-value">10–20 kg</td><td>Outer carton for shipping</td></tr>
          </tbody>
        </table>
      </div>

      <h2>Moisture Protection</h2>
      <div class="prose">
        <p>
          Charcoal is hygroscopic — it absorbs moisture from humid air, which adds dead weight and
          degrades ignition. Retail boxes are typically <strong>moisture-resistant</strong>, and the
          inner 1 kg colour box protects the cubes through transit and shelf time. This is why the
          packaging format is a specification decision, not just a logistics one: a bulk bag in a
          humid destination can arrive heavier and harder to light than the same product in sealed
          retail boxes.
        </p>
      </div>

      <h2>Shelf Life</h2>
      <div class="prose">
        <p>
          Public supplier listings commonly state a <strong>24-month shelf life</strong> for sealed,
          dry-storage charcoal. That figure is tied to the storage condition — "sealed, dry storage"
          — and should not be read as a promise that open or humid storage preserves the product.
          Shelf life is a property of the packaging-and-storage system as much as of the charcoal.
        </p>
      </div>

      <h2>Packaging and Container Loading</h2>
      <div class="prose">
        <p>
          Packaging choice feeds directly into how many tonnes fit a container. Retail boxes waste
          volume relative to bulk bags, so a full retail-packaged 20 ft container loads lighter than
          a bulk-stuffed one. See the <a href="/export/">export page</a> for indicative container
          weights, and the
          <a href={`${SITES.knowledge}/knowledge/charcoal-container-loading/`} target="_blank" rel="noopener">container-loading guide</a>
          for the full trade-off.
        </p>
      </div>

      <div class="callout-pending">
        <span class="callout-title">Data pending — packaging specification in progress</span>
        <p>
          Specific packaging formats, weights and carton dimensions are confirmed per order and added
          to the product database as verified.
        </p>
      </div>

      <div class="cta-banner">
        <h2>Packaging requirements?</h2>
        <p>Tell us your format and target market.</p>
        <a class="btn btn-primary" href="/contact/">Request a Quote →</a>
      </div>
    </div>
  </section>
</BaseLayout>
