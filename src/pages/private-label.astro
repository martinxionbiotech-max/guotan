---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = `${SITES.main}/private-label/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Private Label', url: canonical },
  ]),
];
---

<BaseLayout
  site={site}
  title="Private Label Charcoal — Build Your Own Brand"
  description="Private label and OEM charcoal: choose product, size, packaging and branding. An eight-step process from product selection to shipment."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Private Label', url: '/private-label/' }]}
>
  <div class="page-title container">
    <h1>Private Label Charcoal</h1>
    <p class="lede">
      Build your own charcoal brand. Choose the product, size and packaging, submit your logo, and we
      manage sampling, production, inspection and shipment.
    </p>
    <div class="page-title-media">
      <img src="/images/private-label.webp" alt="Charcoal briquette cubes beside kraft retail boxes with blank label panels on a workbench — conceptual illustration" width="1600" height="900" loading="eager" />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <h2>The Process</h2>
      <ol class="prose">
        <li><strong>Choose Product</strong> — coconut shell hookah, BBQ or bamboo charcoal.</li>
        <li><strong>Choose Size</strong> — 25mm / 26mm / 27mm cube or flat.</li>
        <li><strong>Choose Packaging</strong> — bulk, retail box or custom.</li>
        <li><strong>Submit Logo</strong> — your artwork and brand requirements.</li>
        <li><strong>Sample</strong> — approve a pre-production sample before production.</li>
        <li><strong>Production</strong> — manufacture to the agreed specification.</li>
        <li><strong>Inspection</strong> — quality control before shipment.</li>
        <li><strong>Shipment</strong> — export and delivery to your destination port.</li>
      </ol>

      <h2>What You Can Customize</h2>
      <div class="grid grid-3">
        <div class="card"><h3>Product &amp; Size</h3><p>Coconut shell, BBQ or bamboo charcoal in standard or custom cube sizes.</p></div>
        <div class="card"><h3>Packaging</h3><p>Bulk bags, retail boxes, or branded private-label packaging.</p></div>
        <div class="card"><h3>Branding</h3><p>Your logo, colors and labeling on box and outer carton.</p></div>
      </div>

      <h2>What Private Label Changes: MOQ and Lead Time</h2>
      <div class="prose">
        <p>
          Private label changes two commercial terms relative to buying stock product: the minimum
          order and the lead time. The reason is the printed packaging — your branded boxes and
          labels carry a print-run minimum, and production starts only after your artwork is
          approved.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Order type</th><th>Typical MOQ</th><th>Typical lead time</th></tr>
          </thead>
          <tbody>
            <tr><td>Stock packaging</td><td class="spec-value">~1 tonne</td><td class="spec-value">Shorter (no print step)</td></tr>
            <tr><td>Private label, printed boxes</td><td class="spec-value">One 20 ft container</td><td class="spec-value">15–25 days after artwork approval</td></tr>
          </tbody>
        </table>
      </div>
      <p class="updated">
        These figures reflect common industry practice and public supplier listings, not a
        contractual commitment. The binding terms are confirmed in your written quotation.
      </p>

      <h2>Branding on the Box</h2>
      <div class="prose">
        <ul>
          <li><strong>Logo and colour</strong> — your artwork printed on the retail box and outer carton.</li>
          <li><strong>Multilingual panels</strong> — destination-market language where required.</li>
          <li><strong>Barcode and batch coding</strong> — for retail scanning and traceability.</li>
        </ul>
        <p>
          A common first-brand strategy is to start with neutral or stock packaging to validate the
          product, then move to printed boxes on a larger order — this defers the print minimum
          until the product is proven. See the buyer guidance in our
          <a href={`${SITES.knowledge}/knowledge/`} target="_blank" rel="noopener">knowledge hub</a>
          for the full reasoning.
        </p>
      </div>

      <div class="cta-banner">
        <h2>Start a private label project</h2>
        <p>Tell us your product, size, target market and packaging preference.</p>
        <a class="btn btn-primary" href="/contact/">Start a Private Label Project →</a>
      </div>
    </div>
  </section>
</BaseLayout>
