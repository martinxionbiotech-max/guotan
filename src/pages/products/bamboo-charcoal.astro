---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site-config';
import { SITES } from '../../lib/sites';
import { breadcrumbJsonLd, productJsonLd } from '../../lib/seo';

const canonical = `${SITES.main}/products/bamboo-charcoal/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Products', url: `${SITES.main}/products/` },
    { name: 'Bamboo Charcoal', url: canonical },
  ]),
,
  productJsonLd({
    id: canonical,
    name: 'Bamboo Charcoal',
    description: 'Bamboo charcoal for hookah — FireMax cube and bar formats with supplier-declared specifications.',
    category: 'Charcoal fuel',
    properties: [{ name: 'Raw material', value: 'Bamboo' }, { name: 'Formats', value: 'Cubes 25 mm / 40 mm; silver bars' }, { name: 'Burning time', value: '90 min – 3 h (supplier-declared)' }, { name: 'Ignition', value: '9–10 min cubes; 35–45 s bars' }],
  }),
];
---

<BaseLayout
  site={site}
  title="Bamboo Charcoal"
  description="Bamboo-source charcoal for grilling and specialty applications. Category overview — characteristics and buyer considerations."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Products', url: '/products/' },
    { name: 'Bamboo Charcoal', url: '/products/bamboo-charcoal/' },
  ]}
>
  <div class="page-title-split container">
    <div>
      <h1>Bamboo Charcoal</h1>
      <p class="lede">
        Charcoal produced from bamboo. Lighter and faster-igniting than coconut shell charcoal, bamboo
        charcoal is suited to grilling and applications where quick ignition matters more than long burn.
      </p>
    </div>
    <div class="page-title-media">
      <img src="/images/product-bamboo.webp" alt="Neat bundles of bamboo charcoal sticks on a light concrete table — conceptual illustration" width="1600" height="900" loading="lazy" />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="callout-pending">
        <span class="callout-title">Supplier-declared data — not independently verified</span>
        <p>
          Three bamboo charcoal product records are published with supplier-declared status from
          the FireMax datasheet. They are visible with their declared figures, labelled source and
          verification status — not presented as Charcoal Hub test data.
        </p>
        <p><a href={`${SITES.data}/products/`} target="_blank" rel="noopener">Product Database →</a></p>
      </div>

      <h2>Specification Context</h2>
      <div class="prose">
        <p>
          Bamboo charcoal product records exist in the product database as supplier-declared
          entries — figures come from the FireMax datasheet and are <em>not</em> independently
          tested by Charcoal Hub:
        </p>
        <ul>
          <li><strong>FireMax SL470</strong> — 4 × 4 × 3 cm bamboo cube, burn 2–3 h, ash 3.5–5% (supplier-declared)</li>
          <li><strong>FireMax C25</strong> — 25 mm bamboo cube, burn 90–120 min, calorific 7,500 J (supplier-declared)</li>
          <li><strong>FireMax SI87</strong> — 9 × 2.5 × 1.2 cm silver bar, ignition 35–45 s (supplier-declared)</li>
        </ul>
        <p>
          Full field-level data with source and status:
          <a href={`${SITES.data}/products/`} target="_blank" rel="noopener">Product Database →</a>
        </p>
      </div>
      <div class="grid grid-3" aria-label="FireMax product scene images">
        <figure class="card-media">
          <img src="/images/firemax-sl470.webp" alt="Bamboo charcoal cube blocks beside a hookah — conceptual illustration" width="1600" height="900" loading="lazy" />
          <figcaption>SL470 — 4 cm bamboo cube</figcaption>
        </figure>
        <figure class="card-media">
          <img src="/images/firemax-c25.webp" alt="25 mm bamboo charcoal cubes with calipers — conceptual illustration" width="1600" height="900" loading="lazy" />
          <figcaption>C25 — 25 mm bamboo cube</figcaption>
        </figure>
        <figure class="card-media">
          <img src="/images/firemax-si87.webp" alt="Silver-coated charcoal bars, one glowing — conceptual illustration" width="1600" height="900" loading="lazy" />
          <figcaption>SI87 — silver bar</figcaption>
        </figure>
      </div>

      <h2>Buyer Checklist</h2>
      <div class="prose">
        <ul>
          <li><strong>Method and basis.</strong> Ask which method produced each figure and whether it is dry or as-received.</li>
          <li><strong>Batch linkage.</strong> Confirm which batch, sample and date each number describes.</li>
          <li><strong>Raw report.</strong> Request the laboratory report, not a summary PDF.</li>
          <li><strong>Moisture at origin.</strong> Check moisture at origin and on arrival — charcoal is hygroscopic in transit.</li>
          <li><strong>Size and tolerance.</strong> Confirm the nominal size class and tolerance; verify with calipers on a sample.</li>
          <li><strong>Ignition speed.</strong> Bamboo charcoal is valued for fast ignition; confirm it on a sample burn in your setup.</li>
          <li><strong>Acceptance clause.</strong> Agree sampling and the remedy for an out-of-spec arrival before ordering.</li>
        </ul>
      </div>

      <h2>Verification Status</h2>
      <div class="prose">
        <p>
          No bamboo charcoal product has yet been independently verified by Charcoal Hub, and no
          supplier record has been published. Verified test reports will appear on the
          <a href={`${SITES.testing}/reports/`} target="_blank" rel="noopener">testing sub-site</a>
          as they become attributable.
        </p>
      </div>

      <h2>Related</h2>
      <div class="grid grid-3">
        <a class="card" href={`${SITES.data}/products/`} target="_blank" rel="noopener">
          <h3>Product database <span class="badge badge-muted">data</span></h3>
          <p>All product records with their verification status and source.</p>
        </a>
        <a class="card" href={`${SITES.data}/specifications/ignition-time/`} target="_blank" rel="noopener">
          <h3>Ignition time methodology <span class="badge badge-muted">data</span></h3>
          <p>Why ignition time is a system property and how to compare it.</p>
        </a>
        <a class="card" href={`${SITES.testing}/tests/ignition-time/`} target="_blank" rel="noopener">
          <h3>Test methodology <span class="badge badge-muted">testing</span></h3>
          <p>How ignition time is assessed under defined conditions, with limitations.</p>
        </a>
        <a class="card" href={`${SITES.knowledge}/knowledge/charcoal-odor-and-ignition/`} target="_blank" rel="noopener">
          <h3>Odour &amp; ignition <span class="badge badge-muted">knowledge</span></h3>
          <p>What drives odour and ignition behaviour in charcoal.</p>
        </a>
        <a class="card" href="/request-sample/">
          <h3>Request samples</h3>
          <p>Verify a batch yourself before committing to volume.</p>
        </a>
      </div>

      <div class="cta-banner">
        <h2>Sourcing bamboo charcoal?</h2>
        <p>Tell us quantity and destination port.</p>
        <a class="btn btn-primary" href="/contact/">Request a Quote →</a>
      </div>
    </div>
  </section>
</BaseLayout>
