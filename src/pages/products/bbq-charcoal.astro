---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site-config';
import { SITES } from '../../lib/sites';
import { breadcrumbJsonLd, productJsonLd } from '../../lib/seo';

const canonical = `${SITES.main}/products/bbq-charcoal/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Products', url: `${SITES.main}/products/` },
    { name: 'BBQ Charcoal', url: canonical },
  ]),
,
  productJsonLd({
    id: canonical,
    name: 'Bbq Charcoal',
    description: 'BBQ charcoal category — natural lump and briquette fuels for grilling.',
    category: 'Charcoal fuel',
    properties: [{ name: 'Application', value: 'BBQ / grilling' }],
  }),
];
---

<BaseLayout
  site={site}
  title="BBQ Charcoal"
  description="Coconut and bamboo charcoal for grilling and restaurant use. Category overview — raw material, burn behaviour and buyer considerations."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Products', url: '/products/' },
    { name: 'BBQ Charcoal', url: '/products/bbq-charcoal/' },
  ]}
>
  <div class="page-title-split container">
    <div>
      <h1>BBQ Charcoal</h1>
      <p class="lede">
        Coconut and bamboo charcoal for grilling, restaurants and outdoor cooking. BBQ charcoal is
        selected for consistent heat, long burn and low sparking rather than the odor-neutrality that
        matters most for hookah.
      </p>
    </div>
    <div class="page-title-media">
      <img src="/images/product-bbq.webp" alt="Natural lump charcoal arranged in a brushed steel tray — conceptual illustration" width="1600" height="900" loading="lazy" />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <h2>Raw Material Options</h2>
      <div class="prose">
        <ul>
          <li><strong>Coconut shell</strong> — dense, long-burning, lower ash.</li>
          <li><strong>Bamboo</strong> — lighter, fast-igniting, suited to shorter cooks.</li>
        </ul>
      </div>

      <div class="callout-pending">
        <span class="callout-title">Data pending — supplier verification in progress</span>
        <p>
          Verified BBQ charcoal product entries are added to the product database after supplier
          verification. We do not publish unverified specifications.
        </p>
        <p><a href={`${SITES.data}/products/`} target="_blank" rel="noopener">Product Database →</a></p>
      </div>

      <h2>Specification Context</h2>
      <div class="prose">
        <p>
          Data pending — no verified specification published yet. The product database does not
          currently carry a BBQ charcoal product record, so no declared figures can be cited here.
          Charcoal Hub does not publish unverified numbers.
        </p>
      </div>

      <h2>Buyer Checklist</h2>
      <div class="prose">
        <ul>
          <li><strong>Method and basis.</strong> Ask which method produced each figure and whether it is dry or as-received.</li>
          <li><strong>Batch linkage.</strong> Confirm which batch, sample and date each number describes.</li>
          <li><strong>Raw report.</strong> Request the laboratory report, not a summary PDF.</li>
          <li><strong>Moisture at origin.</strong> Check moisture at origin and on arrival — charcoal is hygroscopic in transit.</li>
          <li><strong>Size and tolerance.</strong> Confirm the nominal size class and tolerance; verify with calipers on a sample.</li>
          <li><strong>Spark level.</strong> For grilling, low sparking is preferred for safety; confirm it on a sample burn.</li>
          <li><strong>Acceptance clause.</strong> Agree sampling and the remedy for an out-of-spec arrival before ordering.</li>
        </ul>
      </div>

      <h2>Verification Status</h2>
      <div class="prose">
        <p>
          No BBQ charcoal product has yet been independently verified by Charcoal Hub, and no
          supplier record has been published. Verified test reports will appear on the
          <a href={`${SITES.testing}/reports/`} target="_blank" rel="noopener">testing sub-site</a>
          as they become attributable.
        </p>
      </div>

      <h2>Related</h2>
      <div class="grid grid-3">
        <a class="card" href={`${SITES.data}/products/`} target="_blank" rel="noopener">
          <h3>Product database <span class="badge badge-muted">data</span></h3>
          <p>All product records with their verification status and source.</p>
        </a>
        <a class="card" href={`${SITES.data}/specifications/ash-content/`} target="_blank" rel="noopener">
          <h3>Specification methodology <span class="badge badge-muted">data</span></h3>
          <p>What ash, moisture and fixed carbon measure and how they are determined.</p>
        </a>
        <a class="card" href={`${SITES.testing}/tests/ash-content/`} target="_blank" rel="noopener">
          <h3>Test methodology <span class="badge badge-muted">testing</span></h3>
          <p>How each parameter is measured under public standards, with limitations.</p>
        </a>
        <a class="card" href={`${SITES.knowledge}/knowledge/how-to-compare-coconut-shell-charcoal/`} target="_blank" rel="noopener">
          <h3>How to compare <span class="badge badge-muted">knowledge</span></h3>
          <p>A buyer guide to reading and comparing supplier spec sheets.</p>
        </a>
        <a class="card" href="/request-sample/">
          <h3>Request samples</h3>
          <p>Verify a batch yourself before committing to volume.</p>
        </a>
      </div>

      <div class="cta-banner">
        <h2>Sourcing BBQ charcoal?</h2>
        <p>Tell us raw material, quantity and destination port.</p>
        <a class="btn btn-primary" href="/contact/">Request a Quote →</a>
        <a class="btn btn-secondary" href="/request-sample/" style="margin-left:0.5rem;">Request Samples →</a>
      </div>
    </div>
  </section>
</BaseLayout>
