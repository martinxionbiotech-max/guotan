---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';

const canonical = `${SITES.main}/contact/`;
---

<BaseLayout
  site={site}
  title="Request a Quote"
  description="Request a quote — all quote requests are handled through the contact page."
  canonical={canonical}
>
  <head><meta http-equiv="refresh" content="0; url=/contact/" /></head>
  <div class="page-title container">
    <h1>Request a Quote</h1>
    <p class="lede">
      Quote requests are handled through the contact page.
      <a href="/contact/">Continue to Contact →</a>
    </p>
  </div>
</BaseLayout>
