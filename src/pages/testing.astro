---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import {
  breadcrumbJsonLd,
  organizationJsonLd,
  webPageJsonLd,
  faqPageJsonLd,
} from '../lib/seo';

const canonical = `${SITES.main}/testing/`;

const title = 'Charcoal Testing & Quality: Methods, Reports and COAs';
const description =
  'How charcoal testing works: method versus report, the six core metrics, what you can request, and how to read a COA before accepting a batch.';

const faqs = [
  {
    q: 'Do you test charcoal in-house?',
    a: 'No. Charcoal Hub is not a laboratory and does not claim an in-house testing facility or accreditation. This site publishes method references, and a sourcing request can include a testing scope: the parameters, the method family, the sample identity and the laboratory are stated before a sample is drawn. The quote states that scope rather than promising a result.',
  },
  {
    q: 'Can I see a sample certificate of analysis?',
    a: 'No. The testing sub-site publishes methodology only, and its reports register shows zero published reports. A sanitised report can only be produced from a real report by removing commercial identifiers such as the buyer, order number and price — it cannot be manufactured from an example. If you have a COA you want read, send the document and it can be reviewed on its merits.',
  },
  {
    q: 'Which standard should I name in a purchase order?',
    a: 'It depends on the parameter, the destination market and what your buyer or regulator requires. Name the method family, the edition and the reporting basis, not just the parameter: for example ASTM D1762 for proximate analysis of wood charcoal, ISO 18122 for ash, ISO 18123 for volatile matter and ISO 18125 for calorific value. Chinese supplier documents often cite GB/T methods; check that the cited method applies to charcoal rather than to a different carbon product before accepting the figure.',
  },
  {
    q: 'Is a supplier-issued COA worthless?',
    a: 'No, but it is a declaration rather than independent verification. A supplier-issued COA can be accurate and still not tell you whether the sample represented the shipped lot. Treat it as the supplier’s statement, ask for the underlying laboratory report and the sampling record, and where the order value justifies it, agree third-party sampling before shipment.',
  },
];

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Testing', url: canonical },
  ]),
  organizationJsonLd({
    id: SITES.main,
    name: 'Charcoal Hub',
    description: site.description,
  }),
  webPageJsonLd({
    id: canonical,
    type: 'WebPage',
    name: title,
    description,
    dateModified: '2026-11-26',
    mainEntityId: SITES.main,
    siteId: SITES.main,
  }),
  faqPageJsonLd({ id: `${canonical}#faq`, faqs }),
];

const documents = [
  {
    doc: 'Method reference',
    answers: 'How is this property defined, and what does the method fix?',
    issuer: 'A standards body, or a reference publisher',
    limit: 'Anything about a product’s measured value',
  },
  {
    doc: 'Supplier datasheet',
    answers: 'What does the supplier declare for this product line?',
    issuer: 'The supplier',
    limit: 'That the value was measured, or that it applies to your lot',
  },
  {
    doc: 'Test report or COA',
    answers: 'What did this sample measure, on this date, by this method?',
    issuer: 'A laboratory, or the supplier if self-declared',
    limit: 'The whole lot, the factory, or the next shipment',
  },
];

const metrics = [
  {
    metric: 'Ash content',
    figure: 'Non-combustible mineral residue left after controlled combustion',
    carries: 'Method and ashing temperature; dry or as-received basis; sample preparation',
  },
  {
    metric: 'Moisture',
    figure: 'Water present in the sample as tested',
    carries: 'Oven-dry method and temperature; sample preparation; reporting basis',
  },
  {
    metric: 'Fixed carbon',
    figure: 'Solid carbon fraction, usually calculated by difference',
    carries: 'The moisture, volatile matter and ash values it was calculated from',
  },
  {
    metric: 'Volatile matter',
    figure: 'Fraction released as gas or vapour under controlled heating',
    carries: 'Method, furnace temperature, hold time and reporting basis',
  },
  {
    metric: 'Burning time',
    figure: 'How long a specified piece burns in a specified arrangement',
    carries: 'Apparatus, sample mass, airflow and ignition method — no universal standard',
  },
  {
    metric: 'Size tolerance',
    figure: 'Permitted dimensional deviation from the nominal size',
    carries: 'Nominal size, measurement points, sample size and pass/fail rule',
  },
];

const coaFields = [
  {
    field: 'Laboratory',
    check: 'Named in full and findable independently of the document',
    failure: 'A logo with no legal entity name',
  },
  {
    field: 'Report number',
    check: 'Traceable to the laboratory’s own record',
    failure: 'Only an internal supplier reference',
  },
  {
    field: 'Sample identity',
    check: 'Grade, size, lot or batch and production date described',
    failure: '“Coconut charcoal” and nothing else',
  },
  {
    field: 'Method and edition',
    check: 'Complete designation, including the edition or year applied',
    failure: '“ASTM” or “internal method” with no number',
  },
  {
    field: 'Result, unit and basis',
    check: 'Unit stated, and dry / as-received / dry ash-free stated',
    failure: 'A percentage with no reporting basis',
  },
  {
    field: 'Accreditation scope',
    check: 'If accreditation is claimed, the scope covers this specific test',
    failure: 'A certificate for a different scope of tests',
  },
  {
    field: 'Remarks and deviations',
    check: 'Any departure from the method is declared',
    failure: 'The method was modified silently',
  },
  {
    field: 'Signature and date',
    check: 'Authorised signatory and a test date that fits the lot',
    failure: 'An undated table with no signature',
  },
];
---

<BaseLayout
  site={site}
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Testing', url: '/testing/' }]}
>
  <div class="page-title container">
    <h1>Testing &amp; Quality</h1>
    <p class="lede">
      A charcoal test figure is not a fact until you know what produced it: which sample, which
      method, which laboratory and which document. This page explains that chain, what can be
      requested for an order, and how to read a certificate of analysis without reading more into
      it than it can carry.
    </p>
    <div class="page-title-media">
      <img src="/images/page-testing.webp" alt="Charcoal testing laboratory bench with balance scale, sieve and beakers of charcoal samples — conceptual illustration" width="1600" height="900" loading="lazy" />
    </div>
  </div>

  <section class="section">
    <div class="container">
      <h2>A Method, a Datasheet and a Report Are Not the Same Document</h2>
      <div class="prose">
        <p>
          Buyers use the word “testing” for three documents that answer different questions. A
          method reference explains how a property is measured; it contains no result for your
          goods. A supplier datasheet states what the supplier declares for a product line; it is a
          commercial description, not a measurement of the lot you will receive. A test report
          records what a laboratory measured on a named sample on a named date. Only the third can
          support a batch acceptance decision, and only for the sample it describes.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Document</th><th>Answers</th><th>Issued by</th><th>What it cannot prove</th></tr>
          </thead>
          <tbody>
            {documents.map((d) => (
              <tr>
                <td>{d.doc}</td>
                <td class="spec-value">{d.answers}</td>
                <td class="spec-value">{d.issuer}</td>
                <td class="spec-value">{d.limit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose">
        <p>
          The distinction is not academic. A supplier-issued COA is a declaration about the
          supplier’s own product. That does not make it false; it makes it non-independent. The
          question to ask is who signed it, and whether the underlying laboratory report and
          sampling record can be produced. If the answer is a screenshot of one table, you have a
          number without a document, and a number without a document cannot be checked.
        </p>
      </div>

      <h2>The Six Core Metrics, and What Must Travel With Each</h2>
      <div class="prose">
        <p>
          Six measurements cover most of what appears on a charcoal datasheet. The figure alone is
          not comparable from one supplier to the next, because the method and the reporting basis
          decide what it means. Ask for both, every time.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Metric</th><th>What the figure represents</th><th>What must be stated with it</th></tr>
          </thead>
          <tbody>
            {metrics.map((m) => (
              <tr>
                <td>{m.metric}</td>
                <td class="spec-value">{m.figure}</td>
                <td class="spec-value">{m.carries}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose">
        <p>
          Two checks catch most of the errors. First, the proximate analysis should reconcile:
          moisture, volatile matter, ash and fixed carbon, reported on the same basis, should sum to
          approximately 100%. If fixed carbon is stated but the other three are missing, the figure
          was calculated from numbers you have not seen. Second, burning time has no universal
          standard. A duration quoted without its apparatus and test conditions is a different
          experiment from the one your buyer ran, even when both are honestly measured.
        </p>
        <p>
          A number without a stated method and basis is a marketing figure, not a specification you
          can enforce. The <a href={`${SITES.testing}/tests/`} target="_blank" rel="noopener">test method reference</a>
          explains what each parameter measures and which public method families are commonly used,
          with no results attached.
        </p>
      </div>

      <h2>What You Can Request</h2>
      <div class="prose">
        <p>
          Testing is a scope, not a product on a shelf. Four requests are worth separating, because
          each produces a different document and supports a different decision.
        </p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>1. A method reference</h3>
          <p>No sample needed. Ask which method family applies to a parameter, what the method fixes, and where its limits are. Start from the testing sub-site’s method pages.</p>
        </div>
        <div class="card">
          <h3>2. A specification review</h3>
          <p>Send the datasheet or the draft purchase order. The review checks that every parameter has a method, a basis, a limit and a test frequency — the four things a supplier can be held to.</p>
        </div>
        <div class="card">
          <h3>3. A sampling and testing scope</h3>
          <p>Agreed before a sample is drawn: parameters, method, laboratory, sample identity and who holds the sample. The laboratory and scope are stated in the quote; the result is not promised in advance.</p>
        </div>
        <div class="card">
          <h3>4. A pre-shipment inspection</h3>
          <p>Count, condition, marks, packaging and photographs of the inspected lot. Chemistry is included only if samples were drawn and tested — an inspection report alone cannot support a chemical claim.</p>
        </div>
      </div>
      <div class="prose">
        <p>
          What to send with any of them: the parameter list, the destination market, the standard
          your buyer or regulator expects, the lot or batch identity, and whether the result is
          needed before production or before shipment. Those five answers decide the scope. Without
          them, a laboratory can still run a test, but nobody can say whether it answers the
          question the order depends on.
        </p>
        <p>
          Testing can be included in a
          <a href="/request-quote/">quote request</a> alongside the product specification. If the
          decision is still at the sample stage, use the
          <a href="/request-sample/">sample request</a> and state which parameters the sample is
          meant to settle.
        </p>
      </div>

      <h2>How to Read a COA</h2>
      <div class="prose">
        <p>
          Read the header before the numbers. A certificate of analysis is a document with an
          issuer, a sample identity and a method; if any of the three is missing, the result cannot
          be tied to your order, however precise the figure looks.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Field</th><th>What to check</th><th>Typical failure</th></tr>
          </thead>
          <tbody>
            {coaFields.map((f) => (
              <tr>
                <td>{f.field}</td>
                <td class="spec-value">{f.check}</td>
                <td class="spec-value">{f.failure}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose">
        <p>
          Five failure patterns are worth naming. A COA with no method cannot be reproduced. A COA
          with no reporting basis cannot be compared. A COA with no lot identity cannot be tied to
          the goods. A COA whose proximate values do not sum has an arithmetic problem somewhere.
          And a COA dated before the production lot, or covering a different grade, is a document
          about something else. None of these requires a laboratory to detect; all of them require
          reading the page rather than the headline.
        </p>
        <p>
          The <a href="/charcoal-testing-coa-guide/">testing and COA guide</a> works through the
          reporting bases, the standard families, sampling handovers and the checks a buyer can run
          without a laboratory. The testing sub-site’s
          <a href={`${SITES.testing}/methods-vs-reports/`} target="_blank" rel="noopener">methods vs reports</a>
          page explains why a method reference is not evidence of a product’s performance.
        </p>
      </div>

      <h2>What This Page Does Not Do</h2>
      <div class="callout-pending">
        <span class="callout-title">Scope and evidence</span>
        <p>
          Charcoal Hub is not a laboratory. It does not perform tests, certify products, approve
          suppliers or claim an accreditation. The testing sub-site publishes methodology only: its
          <a href={`${SITES.testing}/reports/`} target="_blank" rel="noopener">reports register</a>
          holds zero reports, and it says so rather than filling the table with examples. No
          laboratory name, report number or result is invented on this page, and none will be added
          without a real, attributable document that the sender has the right to share.
        </p>
      </div>

      <h2>Testing Questions</h2>
      <div class="prose">
        {faqs.map((f) => (
          <div>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>

      <div class="cta-banner">
        <h2>Need a testing scope for an order?</h2>
        <p>
          Send the parameters, the destination market, the standard your buyer expects and the lot
          identity. We will confirm what can be agreed now, which method family fits, and what has
          to come from the supplier or the laboratory.
        </p>
        <a class="btn btn-primary" href="/request-quote/">Request a Quote →</a>
      </div>
    </div>
  </section>
</BaseLayout>
