---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = `${SITES.main}/testing/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: `${SITES.main}/` },
    { name: 'Testing', url: canonical },
  ]),
];
---

<BaseLayout
  site={site}
  title="Charcoal Testing & Quality"
  description="How we approach charcoal testing — batch testing, third-party vs supplier-reported data, and the metrics we evaluate."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Testing', url: '/testing/' }]}
>
  <div class="page-title container">
    <h1>Testing &amp; Quality</h1>
    <p class="lede">
      Transparent testing is the foundation of a trustworthy charcoal supply. Every data point we
      report is labeled by its source — third-party laboratory, supplier-provided, or not yet verified.
    </p>
  </div>

  <section class="section">
    <div class="container">
      <h2>The Six Core Metrics</h2>
      <div class="prose">
        <p>
          Six measurements cover most of what appears on a charcoal datasheet. Each is a public
          methodology, explained in detail on the testing sub-site.
        </p>
      </div>
      <div class="grid grid-3">
        <div class="card"><h3>Ash content</h3><p>Residue after combustion — a key hookah quality signal.</p></div>
        <div class="card"><h3>Moisture</h3><p>Affects ignition and burn consistency.</p></div>
        <div class="card"><h3>Fixed carbon</h3><p>Drives energy density and burn quality.</p></div>
        <div class="card"><h3>Volatile matter</h3><p>Affects ignition and smoke.</p></div>
        <div class="card"><h3>Burning time</h3><p>Session duration under controlled conditions.</p></div>
        <div class="card"><h3>Size tolerance</h3><p>Dimensional consistency across a batch.</p></div>
      </div>

      <h2>How to Read a Test Figure</h2>
      <div class="prose">
        <ul>
          <li><strong>Ash content</strong> — the non-combustible mineral residue; lower generally means less residue in the bowl. Ask for the method and the basis (dry vs as-received).</li>
          <li><strong>Moisture</strong> — water weight you pay to ship; higher moisture makes charcoal harder to light. Ask for the oven-dry method and the basis.</li>
          <li><strong>Fixed carbon</strong> — the solid carbon fraction, calculated by difference, not measured directly. Check it reconciles with moisture, volatile matter and ash.</li>
          <li><strong>Volatile matter</strong> — the quick-releasing fraction; drives ignition speed and start-up smoke.</li>
          <li><strong>Burning time</strong> — has no universal standard; the test conditions must travel with the figure or it is not comparable.</li>
          <li><strong>Size tolerance</strong> — permitted dimensional deviation from the nominal size; define it in the purchase spec.</li>
        </ul>
        <p>
          A number without a stated method and basis is a marketing figure, not a specification you
          can enforce.
        </p>
      </div>

      <h2>Data Source Transparency</h2>
      <div class="prose">
        <ul>
          <li><strong>Third-party laboratory testing</strong> — clearly labeled as such.</li>
          <li><strong>Supplier-provided test data</strong> — clearly labeled as supplier reported, never presented as independent fact.</li>
          <li><strong>Not yet available</strong> — we do not claim testing capabilities we do not yet have.</li>
        </ul>
      </div>

      <p><a class="btn btn-secondary" href={`${SITES.testing}/`} target="_blank" rel="noopener">Testing Methodology →</a></p>

      <div class="cta-banner">
        <h2>Request product information</h2>
        <p>Ask about specifications and testing for any product.</p>
        <a class="btn btn-primary" href="/contact/">Request Product Information →</a>
      </div>
    </div>
  </section>
</BaseLayout>
